[gd_resource type="Resource" script_class="EventData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/event_choice_data.gd" id="2_choice"]
[ext_resource type="Script" path="res://scripts/resources/drop_table.gd" id="3_table"]
[ext_resource type="Script" path="res://scripts/resources/drop_entry.gd" id="4_entry"]

[sub_resource type="Resource" id="Resource_shard"]
script = ExtResource("4_entry")
currency = &"shards"
chance = 1.0
min_amount = 1
max_amount = 1

[sub_resource type="Resource" id="Resource_reward"]
script = ExtResource("3_table")
entries = Array[ExtResource("4_entry")]([SubResource("Resource_shard")])

[sub_resource type="Resource" id="Resource_offer"]
script = ExtResource("2_choice")
label = "Offer blood"
hp_cost_fraction = 0.2
success_chance = 1.0
reward = SubResource("Resource_reward")
success_text = "The moss drinks, then glows. A Power Shard rises from the stone."

[sub_resource type="Resource" id="Resource_leave"]
script = ExtResource("2_choice")
label = "Leave it"
success_text = "You bow to the old stones and walk on."

[resource]
script = ExtResource("1_event")
id = &"mossy_shrine"
title = "Mossy Shrine"
text = "An old shrine hums under the moss.
It asks for a little of your strength."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_offer"), SubResource("Resource_leave")])
