[gd_resource type="Resource" script_class="VillagerData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/villager_data.gd" id="1_villager"]
[ext_resource type="Script" path="res://scripts/resources/service_data.gd" id="2_service"]
[ext_resource type="Script" path="res://scripts/resources/modifier_data.gd" id="3_mod"]

[sub_resource type="Resource" id="Mod_base_1"]
script = ExtResource("3_mod")
target = &"run.revives"
value = 1

[sub_resource type="Resource" id="Resource_base"]
script = ExtResource("2_service")
description = "1 revive token every run (you get up at 30% HP)."
modifiers = Array[ExtResource("3_mod")]([SubResource("Mod_base_1")])

[resource]
script = ExtResource("1_villager")
id = &"healer"
display_name = "Osk"
job_name = "Healer"
workplace = "Clinic"
base_service = SubResource("Resource_base")
color = Color(0.84, 0.66, 0.74, 1)
arrives_at_renown = 2
home_plot = 3
greeting = "Come back in one piece. Or at least in a few."
