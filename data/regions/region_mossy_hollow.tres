[gd_resource type="Resource" script_class="RegionData" load_steps=25 format=3]

[ext_resource type="Script" path="res://scripts/resources/region_data.gd" id="1_region"]
[ext_resource type="Script" path="res://scripts/resources/encounter_data.gd" id="2_encounter"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mossy_test.tres" id="3_test"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mossy_sprouts.tres" id="4_sprouts"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mossy_boars.tres" id="5_boars"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mossy_archers.tres" id="6_archers"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mossy_elder_boar.tres" id="7_elder"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mossy_spore_witch.tres" id="10_witch"]
[ext_resource type="Resource" path="res://data/encounters/encounter_mother_toad.tres" id="8_toad"]
[ext_resource type="Resource" path="res://data/encounters/encounter_warden_of_roots.tres" id="9_warden"]
[ext_resource type="Script" path="res://scripts/resources/drop_table.gd" id="11_table"]
[ext_resource type="Script" path="res://scripts/resources/drop_entry.gd" id="12_entry"]
[ext_resource type="Script" path="res://scripts/resources/event_data.gd" id="13_event"]
[ext_resource type="Resource" path="res://data/events/event_mossy_shrine.tres" id="14_shrine"]
[ext_resource type="Resource" path="res://data/events/event_wishing_well.tres" id="15_well"]
[ext_resource type="Script" path="res://scripts/resources/power_data.gd" id="16_power"]
[ext_resource type="Resource" path="res://data/powers/power_fire.tres" id="17_fire"]
[ext_resource type="Resource" path="res://data/powers/power_frost.tres" id="18_frost"]
[ext_resource type="Resource" path="res://data/powers/power_growth.tres" id="19_growth"]
[ext_resource type="Resource" path="res://data/powers/power_stone.tres" id="20_stone"]

[sub_resource type="Resource" id="Resource_chest_coins"]
script = ExtResource("12_entry")
currency = &"coins"
chance = 1.0
min_amount = 20
max_amount = 35

[sub_resource type="Resource" id="Resource_chest_wood"]
script = ExtResource("12_entry")
currency = &"wood"
chance = 1.0
min_amount = 3
max_amount = 6

[sub_resource type="Resource" id="Resource_chest_shard"]
script = ExtResource("12_entry")
currency = &"shards"
chance = 0.25
min_amount = 1
max_amount = 1

[sub_resource type="Resource" id="Resource_chest_crystal"]
script = ExtResource("12_entry")
currency = &"crystal"
chance = 0.1
min_amount = 1
max_amount = 1

[sub_resource type="Resource" id="Resource_chest"]
script = ExtResource("11_table")
entries = Array[ExtResource("12_entry")]([SubResource("Resource_chest_coins"), SubResource("Resource_chest_wood"), SubResource("Resource_chest_shard"), SubResource("Resource_chest_crystal")])

[resource]
script = ExtResource("1_region")
id = &"mossy_hollow"
display_name = "Mossy Hollow"
floor_count = 3
min_depth = 5
max_depth = 7
min_row_width = 2
max_row_width = 3
branch_chance = 0.6
room_weights = Dictionary[StringName, float]({
&"combat": 50.0,
&"elite": 12.0,
&"treasure": 10.0,
&"rest": 8.0,
&"merchant": 7.0,
&"event": 8.0
})
elite_min_row = 2
combat_encounters = Array[ExtResource("2_encounter")]([ExtResource("3_test"), ExtResource("4_sprouts"), ExtResource("5_boars"), ExtResource("6_archers")])
elite_encounters = Array[ExtResource("2_encounter")]([ExtResource("7_elder"), ExtResource("10_witch")])
mini_boss_encounter = ExtResource("8_toad")
boss_encounter = ExtResource("9_warden")
floor_color = Color(0.2, 0.26, 0.19, 1)
material = &"wood"
treasure_drops = SubResource("Resource_chest")
events = Array[ExtResource("13_event")]([ExtResource("14_shrine"), ExtResource("15_well")])
power_pool = Array[ExtResource("16_power")]([ExtResource("17_fire"), ExtResource("18_frost"), ExtResource("19_growth"), ExtResource("20_stone")])
