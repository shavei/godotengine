[gd_resource type="Resource" script_class="EncounterData" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/resources/encounter_data.gd" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/resources/wave_data.gd" id="2_wave"]
[ext_resource type="Script" path="res://scripts/resources/enemy_data.gd" id="3_enemy"]
[ext_resource type="Resource" path="res://data/enemies/enemy_sproutling.tres" id="4_sproutling"]
[ext_resource type="Resource" path="res://data/enemies/enemy_tusk_boar.tres" id="5_boar"]
[ext_resource type="Resource" path="res://data/enemies/enemy_thorn_archer.tres" id="6_archer"]

[sub_resource type="Resource" id="Resource_wave1"]
script = ExtResource("2_wave")
enemies = Array[ExtResource("3_enemy")]([ExtResource("4_sproutling"), ExtResource("4_sproutling"), ExtResource("4_sproutling")])

[sub_resource type="Resource" id="Resource_wave2"]
script = ExtResource("2_wave")
enemies = Array[ExtResource("3_enemy")]([ExtResource("5_boar"), ExtResource("4_sproutling"), ExtResource("4_sproutling")])

[sub_resource type="Resource" id="Resource_wave3"]
script = ExtResource("2_wave")
enemies = Array[ExtResource("3_enemy")]([ExtResource("6_archer"), ExtResource("6_archer"), ExtResource("5_boar"), ExtResource("4_sproutling")])

[sub_resource type="Resource" id="Resource_wave4"]
script = ExtResource("2_wave")
enemies = Array[ExtResource("3_enemy")]([ExtResource("5_boar"), ExtResource("6_archer"), ExtResource("4_sproutling"), ExtResource("4_sproutling")])

[resource]
script = ExtResource("1_encounter")
id = &"mossy_test"
display_name = "Mossy Hollow test room"
waves = Array[ExtResource("2_wave")]([SubResource("Resource_wave1"), SubResource("Resource_wave2"), SubResource("Resource_wave3"), SubResource("Resource_wave4")])
wave_delay = 1.2
