[gd_resource type="Resource" script_class="ComboData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/combo_data.gd" id="1_combo"]
[ext_resource type="Script" path="res://scripts/resources/service_data.gd" id="2_service"]
[ext_resource type="Script" path="res://scripts/resources/modifier_data.gd" id="3_mod"]

[sub_resource type="Resource" id="Mod_novice_1"]
script = ExtResource("3_mod")
target = &"hero.heal_per_room"
value = 3

[sub_resource type="Resource" id="Resource_novice"]
script = ExtResource("2_service")
description = "Herbal care: heal 3 HP for every fight room cleared."
modifiers = Array[ExtResource("3_mod")]([SubResource("Mod_novice_1")])

[sub_resource type="Resource" id="Mod_adept_1"]
script = ExtResource("3_mod")
target = &"hero.heal_per_room"
value = 3

[sub_resource type="Resource" id="Resource_adept"]
script = ExtResource("2_service")
description = "Heal 6 HP."
modifiers = Array[ExtResource("3_mod")]([SubResource("Mod_adept_1")])

[resource]
script = ExtResource("1_combo")
id = &"healer_growth"
villager_id = &"healer"
power_id = &"growth"
novice = SubResource("Resource_novice")
adept = SubResource("Resource_adept")
technique_name = "Second Wind"
technique_text = "Heal 15% when you enter each floor."
gift_line = "Herbs for every room you clear. Come back whole."
