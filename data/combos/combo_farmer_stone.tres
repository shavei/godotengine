description = "+80 coins and +10 Wood every run."

[resource]
script = ExtResource("1_combo")
id = &"farmer_stone"
villager_id = &"farmer"
power_id = &"stone"
novice = SubResource("Resource_novice")
adept = SubResource("Resource_adept")
